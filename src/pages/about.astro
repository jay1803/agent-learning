---
import BaseLayout from 'astro-reading-theme/layouts/BaseLayout.astro';
---

<BaseLayout title="About — Agent Learning">
  <article class="about">
    <p class="about-eyebrow">About</p>
    <h1>Notes on learning agents</h1>
    <div class="prose">
      <p>A hand-curated log of articles about AI agents, each summarized in Chinese
      and linked back to its source.</p>

      <h2>How it works</h2>
      <p>I send the agent a URL. It fetches the full article, writes a dense summary
      focused on the author's least obvious insights, and publishes it here.
      Nothing is scheduled or automatic; every entry is something I chose to read.</p>

      <h2>The summaries</h2>
      <p>Written in Chinese by default. Conclusion first, then reasoning, no filler.
      Paraphrased, not translated.</p>
    </div>
  </article>
</BaseLayout>

<style>
  .about {
    max-width: var(--measure);
    padding: 4rem 0 6rem;
  }
  .about-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 1rem;
  }
  .about h1 {
    font-size: clamp(2rem, 1.6rem + 1.6vw, 2.75rem);
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0 0 2rem;
  }
</style>
